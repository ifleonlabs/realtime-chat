# Copy this file to ".env" and adjust. All values are optional except the
# JWT secret, which you MUST set for any non-local deployment.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_JWT_SECRET=change-me-to-a-long-random-string

# How long an access token stays valid (minutes).
CHAT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLAlchemy database URL (defaults to a SQLite file in ~/.realtime-chat/).
# CHAT_DATABASE_URL=sqlite:///./chat.db

# Default lifetime for new rooms in hours, and how often expired rooms are purged.
CHAT_DEFAULT_ROOM_LIFETIME_HOURS=24
CHAT_CLEANUP_INTERVAL_SECONDS=300

# How many recent messages a client receives when joining a room.
CHAT_HISTORY_LIMIT=50

# Maximum accepted length of a single message.
CHAT_MAX_MESSAGE_LENGTH=2000
